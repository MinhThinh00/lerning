# ============================================================
# Copy thành .env rồi sửa:   cp .env.example .env
# .env KHÔNG commit (đã có trong .gitignore).
# Giá trị dưới đây chỉ dành cho DEV. Lên server: đổi toàn bộ password/secret.
# ============================================================

COMPOSE_PROJECT_NAME=shop

# ── Chọn thành phần (xem compose.yaml) ──────────────────────
# Local dev, chạy app từ IDE:      kafka-single,redis-single
# Local dev + quan sát:            kafka-single,redis-single,observability,tools
# Full stack trong Docker:         kafka-single,redis-single,observability,apps
# Lab HA (failover Redis/Kafka):   kafka-cluster,redis-sentinel,apps
# COMPOSE_PROFILES=kafka-single,redis-single
COMPOSE_PROFILES=
# ── Network binding ─────────────────────────────────────────
# Port của infra (MySQL, Redis, Kafka, Consul, Kibana, Grafana...) chỉ bind vào
# địa chỉ này. Trên server giữ 127.0.0.1 → truy cập qua SSH tunnel.
BIND_ADDR=127.0.0.1
# Port public (gateway, keycloak). Trên server nên đặt reverse proxy (TLS) phía trước.
PUBLIC_BIND_ADDR=0.0.0.0

# ── Image của apps ──────────────────────────────────────────
# Registry (local: để "shop"; server: vd ghcr.io/<user>)
REGISTRY=shop
# Tag BẤT BIẾN (git sha ngắn hoặc semver). KHÔNG dùng latest → mới rollback được.
# Tag mặc định cho mọi service:
APP_TAG=0.1.0
# Ghi đè từng service (deploy / rollback độc lập). Bỏ trống = dùng APP_TAG.
GATEWAY_TAG=
USER_SERVICE_TAG=
PRODUCT_SERVICE_TAG=
INVENTORY_SERVICE_TAG=
ORDER_SERVICE_TAG=
PAYMENT_SERVICE_TAG=
NOTIFICATION_SERVICE_TAG=
SPRING_PROFILES_ACTIVE=prod
 
# ── MySQL ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=dev-root-pass
# Mỗi service 1 database + 1 user riêng (least privilege)
DB_PASSWORD_USER=dev-user-pass
DB_PASSWORD_PRODUCT=dev-product-pass
DB_PASSWORD_INVENTORY=dev-inventory-pass
DB_PASSWORD_ORDER=dev-order-pass
DB_PASSWORD_PAYMENT=dev-payment-pass
DB_PASSWORD_NOTIFICATION=dev-notification-pass
DB_PASSWORD_KEYCLOAK=dev-keycloak-pass

# ── Keycloak ────────────────────────────────────────────────
# URL Keycloak PHẢI giống nhau từ browser, từ app trên host và từ container
# (issuer trong JWT phải khớp). Local: thêm "127.0.0.1 keycloak" vào file hosts.
# Server: đổi thành domain thật, vd https://auth.example.com
KEYCLOAK_URL=http://keycloak:8180
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-admin-pass
# start-dev cho local; server dùng "start" (xem docs/02-DEPLOYMENT.md)
KEYCLOAK_COMMAND=start-dev
# Secret của confidential client shop-service (được import vào realm)
SHOP_SERVICE_CLIENT_SECRET=dev-shop-service-secret
# Password chung của các test user trong realm (admin, seller1, inv.manager, user1)
SHOP_TEST_USER_PASSWORD=Dev@12345
# Redirect URI cho public client shop-app (gateway / SPA). Realm thêm hậu tố "/*".
SHOP_APP_REDIRECT_URI=http://localhost:8080

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=dev-redis-pass
# Phải khớp profile ở COMPOSE_PROFILES:
#   redis-single   → REDIS_MODE=single,   REDIS_EXPORTER_TARGET=redis
#   redis-sentinel → REDIS_MODE=sentinel, REDIS_EXPORTER_TARGET=redis-master
# Apps nạp apps/env/redis-${REDIS_MODE}.env
REDIS_MODE=single
REDIS_EXPORTER_TARGET=redis

# ── Kafka (KRaft) ───────────────────────────────────────────
# Tạo mới: docker run --rm confluentinc/cp-kafka:7.7.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qg
# Host mà app chạy NGOÀI Docker dùng để kết nối (listener EXTERNAL)
KAFKA_EXTERNAL_HOST=localhost
# Bootstrap cho container trong network:
#   kafka-single : kafka:29092
#   kafka-cluster: kafka-1:29092,kafka-2:29092,kafka-3:29092
KAFKA_BOOTSTRAP=kafka:29092
# kafka-single: 1 | kafka-cluster: 3
KAFKA_REPLICATION_FACTOR=1
KAFKA_PARTITIONS=3

# ── Observability ───────────────────────────────────────────
ELASTIC_VERSION=8.13.4
GRAFANA_ADMIN_PASSWORD=dev-grafana-pass
# Tỉ lệ lấy mẫu trace: 1.0 dev, 0.1 server
TRACING_SAMPLING_PROBABILITY=1.0
